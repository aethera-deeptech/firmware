{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigestsToSemver"],
  "timezone": "Asia/Jakarta",
  "schedule": ["before 7am on monday"],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "rebaseWhen": "conflicted",
  "platformCommit": "enabled",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "labels": ["dependencies"],
  "assignees": ["SyafaHadyan"],
  "dependencyDashboard": true,
  "vulnerabilityAlerts": {
    "semanticCommitType": "fix"
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci",
      "addLabels": ["github_actions"]
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "actions"
    },
    {
      "description": "the images of .github/tools/Dockerfile are the tools that CI starts from a workflow, so they take the commit type of the workflows",
      "matchManagers": ["dockerfile"],
      "matchFileNames": [".github/tools/Dockerfile"],
      "semanticCommitType": "ci",
      "addLabels": ["github_actions"]
    },
    {
      "description": "ghcr.io gives Renovate no release time, so with the 7 day wait and the strict filter an update of a GHCR image would be held forever, these images skip the age check",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/**"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "the tools that CI starts from a workflow, such as ls-lint and Renovate itself, take the commit type of the workflows",
      "matchManagers": ["custom.regex"],
      "semanticCommitType": "ci",
      "addLabels": ["github_actions"]
    },
    {
      "description": "a major version of the espressif32 platform switches to the Arduino-ESP32 3.x core, which changes the ESP-NOW API, so it is held until the firmware is ported",
      "matchDepNames": ["platformio/platform-espressif32"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "the platform and the Python tools of the firmware build take the commit type of the packages",
      "matchDepNames": ["platformio/platform-espressif32", "platformio", "gcovr"],
      "semanticCommitType": "build"
    }
  ],
  "customManagers": [
    {
      "description": "A version in a workflow that the line above names with a renovate comment, which the bot cannot find in a run step or an action input otherwise",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*(?:[a-z0-9-]*version|[A-Z][A-Z0-9_]*_VERSION): [\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ]
    },
    {
      "description": "The PlatformIO platform that the renovate comment above it names in platformio.ini, where the tag of a release starts with v",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)platformio\\.ini$/"],
      "matchStrings": ["; renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*platform = espressif32@(?<currentValue>\\S+)"],
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ]
}
